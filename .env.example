# Polymarket CLOB API key — required for trading execution (not needed for discovery)
POLYMARKET_API_KEY=

# Live trading gate — set to true ONLY after paper trading validation
LIVE_TRADING_ENABLED=false
PREFER_MAKER_ORDERS=true
MAKER_ORDER_TIMEOUT_S=300
MAKER_SELL_MAX_RETRIES=3
MAKER_SELL_RETRY_INTERVAL_S=60

# Polymarket wallet credentials (required for live trading)
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=1
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Paper-trading mode (hybrid exit)
PAPER_STAKE_USD=1.0
PAPER_BASE_WALLET=5.0
PAPER_MAX_OPEN_POSITIONS=5
PAPER_STATE_FILE=logs/paper_positions_5usd.json

# Hybrid strategy controls
HYBRID_STOP_LOSS_MULTIPLIER=0.55
HYBRID_TAKE_PROFIT_MIN_PRICE=0.55
HYBRID_TAKE_PROFIT_MAX_PRICE=0.70
HYBRID_MIN_CONFIDENCE_TO_HOLD=0.55

# Exact bracket tuning
EXACT_BRACKET_TP_CAP=0.80
EXACT_BRACKET_SL_COOLDOWN_HOURS=1.0

# Flash crash shield tuning
FLASH_CRASH_L1_ESCAPE_SECONDS=60
SL_MAX_DELAY_SECONDS=600

# Liquidity Gates
MARKET_MIN_VOLUME_24HR=500
MARKET_MAX_SPREAD_GATE=0.12
LIQUIDITY_DEPTH_MULTIPLIER=1.2

# Entry strategy thresholds (DATA COLLECTOR MODE)
STRATEGY_MAX_YES_PRICE=0.75
STRATEGY_MIN_MODEL_PROB=0.60
STRATEGY_MIN_EDGE=0.10
DISCOVERY_MAX_FETCH_PAGES=15

# Golden Window (hours before resolve) — 4-18h for data collection phase
GOLDEN_WINDOW_HOURS_MAX=18
GOLDEN_WINDOW_HOURS_MIN=4

# Resolve-date window mode
DAILY_RESOLVE_ONLY=true
DAILY_MIN_HOURS_TO_RESOLVE=0
DAILY_MIN_RESOLVE_DAYS_AHEAD=1
DAILY_MAX_RESOLVE_DAYS_AHEAD=2

# AI / Haiku — DISABLED (deterministic model is sufficient, AI caused losses historically)
HAIKU_ENTRY_ENABLED=false
HAIKU_MONITOR_ENABLED=false
HAIKU_SENSING_ENABLED=false

# [MODUL N] Mobile Alerts (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
