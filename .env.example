# Polymarket CLOB API key — required for trading execution (not needed for discovery)
POLYMARKET_API_KEY=

# Open-Meteo does not require authentication

# Official Polymarket CLOB orderbook endpoint (best bid/ask by token_id)
CLOB_BOOK_API=https://clob.polymarket.com/book

# Paper-trading mode (hybrid exit)
PAPER_STAKE_USD=100
PAPER_ENTRY_MIN_PRICE=0.20
PAPER_ENTRY_MAX_PRICE=0.30
PAPER_MAX_OPEN_POSITIONS=3
PAPER_MAX_OPEN_PER_CITY=1
PAPER_MIN_CITY_DIVERSITY=5
PAPER_STATE_FILE=logs/paper_positions.json

# Hybrid strategy controls
HYBRID_TAKE_PROFIT_MULTIPLIER=2.0
HYBRID_TAKE_PROFIT_MIN_PRICE=0.50
HYBRID_TAKE_PROFIT_MAX_PRICE=0.60
HYBRID_STOP_LOSS_MULTIPLIER=0.48
HYBRID_LATE_WINDOW_HOURS=2.0
HYBRID_MIN_CONFIDENCE_TO_HOLD=0.75
HYBRID_CONFIDENCE_EDGE_SCALE=0.35

# Entry bucket decision thresholds
ENTRY_BUCKET_HOLD_MIN_PROB=0.90
ENTRY_BUCKET_HOLD_MIN_EDGE=0.60
ENTRY_BUCKET_HOLD_MIN_CONFIDENCE=0.75
ENTRY_BUCKET_WATCH_MAX_PRICE=0.40

# Weather evidence quality controls
WEATHER_EVIDENCE_MAX_AGE_HOURS=3.0
WEATHER_EVIDENCE_MIN_QUALITY_SCORE=0.65

# Paper loop interval (seconds)
PAPER_LOOP_INTERVAL_SECONDS=300
PAPER_JOURNAL_MAX_ENTRIES=300
PAPER_REPORT_RETENTION_WARN_THRESHOLD=1000
PAPER_REPORT_ANOMALY_STREAK_ALERT=3
PAPER_REPORT_REJECT_DOMINANT_RATIO=0.85

# Discovery scan depth for additional market pages
DISCOVERY_MAX_FETCH_PAGES=2
DISCOVERY_ENABLE_AUTO_AGGRESSIVE_SCAN=true
DISCOVERY_AGGRESSIVE_SCAN_PAGES=3
DISCOVERY_AUTO_AGGRESSIVE_AFTER_EMPTY_CYCLES=3
DAILY_RESOLVE_ONLY=true
DAILY_MIN_HOURS_TO_RESOLVE=0
DAILY_MIN_RESOLVE_DAYS_AHEAD=1
DAILY_MAX_RESOLVE_DAYS_AHEAD=2
DISCOVERY_FORECAST_PREFETCH_MIN_KEYS=4
DISCOVERY_FORECAST_PREFETCH_MAX_WORKERS=4
PAPER_POSITION_FORECAST_PREFETCH_MIN_KEYS=3
PAPER_POSITION_FORECAST_PREFETCH_MAX_WORKERS=4

# Entry strategy thresholds (weather-temperature opportunities)
STRATEGY_MAX_YES_PRICE=0.35
STRATEGY_MIN_MODEL_PROB=0.70
STRATEGY_MIN_EDGE=0.35
STRATEGY_EXACT_MIN_MODEL_PROB=0.10
STRATEGY_EXACT_MIN_EDGE=0.02

# Future AI-agent integration placeholders (not used by runtime yet)
AI_AGENT_ENABLED=false
AI_AGENT_PROVIDER=
AI_AGENT_MODEL=
AI_AGENT_API_KEY=
AI_AGENT_ENDPOINT=
AI_AGENT_MIN_OVERRIDE_CONFIDENCE=0.80
AI_AGENT_TIMEOUT_SECONDS=5.0

# Anthropic AI (entry gate + position monitor)
ANTHROPIC_API_KEY=
AI_ENABLE_WEB_SEARCH=false
AI_MONTHLY_BUDGET_USD=5.0
AI_USAGE_LEDGER_FILE=logs/ai_usage_ledger.json

# Sonnet entry gate (called only on pre-filtered exact opportunities)
SONNET_ENTRY_ENABLED=false
SONNET_ENTRY_MIN_CONFIDENCE=0.80
SONNET_ENTRY_MODEL=claude-sonnet-4-6
SONNET_ENTRY_MAX_TOKENS=500
SONNET_ENTRY_MAX_CALLS_PER_DAY=6
SONNET_ENTRY_CACHE_FILE=logs/sonnet_entry_cache.json
SONNET_ENTRY_CACHE_TTL_HOURS=6

# Haiku open-position monitor
HAIKU_MONITOR_ENABLED=false
HAIKU_MONITOR_INTERVAL_HOURS=6.0
HAIKU_MONITOR_MODEL=claude-haiku-4-5-20251001
HAIKU_MONITOR_MAX_TOKENS=220
HAIKU_MONITOR_MAX_CALLS_PER_DAY=24
HAIKU_MONITOR_MIN_CONFIDENCE_TO_EXIT=0.75
HAIKU_MONITOR_CACHE_FILE=logs/haiku_monitor_cache.json

# WebSocket real-time position monitor (stop-loss / take-profit)
WS_PRICE_WATCHER_ENABLED=true
WS_PRICE_WATCHER_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
WS_RECONNECT_DELAY_SECONDS=5
WS_PING_INTERVAL_SECONDS=10

# Browser realtime feed broadcaster (backend internal WS server)
WS_BROADCAST_HOST=127.0.0.1
WS_BROADCAST_PORT=8081
WS_BROADCAST_MAX_CLIENTS=10
WS_BROADCAST_PING_INTERVAL_SECONDS=20
